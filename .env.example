# Example: copy values into your shell environment (the app does not auto-load .env).
VERIFAI_DATA=./data
VLM_ENABLED=0
VLM_MODEL=qwen3-vl:4b-instruct
VLM_BASE_URL=http://127.0.0.1:11434
VLM_TIMEOUT_SECONDS=120
VLM_MAX_FRAMES=4
VLM_MAX_PAIRS=2
VLM_ALLOW_REMOTE=0
# OCR: PP-OCRv5 multilingual Vietnamese recognition
OCR_LANG=vi
# ASR CPU defaults; switch to small for better Vietnamese accuracy if RAM permits.
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local OCR sampling and analysis concurrency (single Uvicorn worker)
# Tradeoff: fewer OCR frames = faster CPU inference, but may miss brief text.
OCR_MAX_FRAMES=12
MAX_CONCURRENT_JOBS=1
