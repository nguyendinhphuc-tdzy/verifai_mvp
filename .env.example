# Copy to .env (git-ignored). backend.py loads .env at startup; real environment variables win.
VERIFAI_DATA=./data
VLM_ENABLED=0
GEMINI_API_KEY=
# Gemini receives selected JPEG frame data: obtain rights and consent before enabling cloud inference.
VLM_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_ATTEMPTS=1
GEMINI_THINKING_LEVEL=low
VLM_TIMEOUT_SECONDS=90
# Soft budget applies between calls, not during an active SDK call.
VLM_TOTAL_BUDGET_SECONDS=120
VLM_STOP_AFTER_FAILURES=2
VLM_MAX_FRAMES=1
VLM_MAX_PAIRS=0
# After repeated Gemini 503/504, skip cloud calls in subsequent queued jobs.
VLM_CIRCUIT_ENABLED=1
VLM_CIRCUIT_FAILURES=2
VLM_CIRCUIT_COOLDOWN_SECONDS=180
# Speed (04/11/2026): start the 3 Gemini calls right after upload, in parallel with
# local OCR/ASR; load OCR/ASR models in the background when the app starts.
VLM_PREFETCH=1
WARM_MODELS=1
OCR_ENABLED=1
ASR_ENABLED=1
# OCR: PP-OCRv5 multilingual Vietnamese recognition
OCR_LANG=vi
# ASR CPU defaults; switch to small for better Vietnamese accuracy if RAM permits.
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=vi
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local OCR sampling and analysis concurrency (single Uvicorn worker)
# Tradeoff: fewer OCR frames = faster CPU inference, but may miss brief text.
OCR_MAX_FRAMES=12
OCR_SAMPLING_MODE=hybrid
# OCR coverage: adaptive (default; every frame checked, OCR on a <=0.5 s grid + visual changes,
# text changes bisected, new numeric text re-read at full resolution), all (OCR every frame, slow
# reference), sampled (legacy OCR_MAX_FRAMES subset).
OCR_SCAN_MODE=adaptive
OCR_MAX_GAP_SECONDS=0.5
OCR_MIN_GAP_SECONDS=0.25
OCR_CHANGE_THRESHOLD=12
OCR_FULLRES_RECHECK=1
MAX_CONCURRENT_JOBS=1
# Usage rights that allow sending media to Gemini (never "unknown").
VLM_CLOUD_RIGHTS=self_created,permission_granted,public_review_only

# ---- Cloud demo (Hugging Face Spaces) ----
# Local runs auto-load ./.env (existing environment variables win).
# Remote access stays disabled unless BOTH are set; the code must be >= 8 chars.
# Browser login: any username, password = access code. Shared secret, not per-user auth.
VERIFAI_PUBLIC_MODE=0
VERIFAI_ACCESS_CODE=
# Product-only seed loaded when the database does not exist (cloud has no persistent disk).
VERIFAI_SEED_DB=
